# 배포 번들에 넣을 필요 없는 것들 — 특히 아래 참고자료 폴더는 30MB짜리 CSV가 들어있어서 제외.
(251128)소상공인시장진흥공단_상가(상권)정보_OpenApi 활용가이드/
backend/data/cache/
backend/scripts/*.out.json

# .env는 절대 업로드하지 않는다. `vercel --prod`로 로컬에서 배포할 때 이게 딸려 올라가면
# 서버리스 함수의 dotenv가 그 파일을 읽어버려서, Vercel 환경변수가 틀려 있어도 앱이 동작해
# 문제가 가려진다(= 지금 겪은 종류의 버그를 더 찾기 어렵게 만든다). 시크릿은 Vercel
# 환경변수 하나만을 출처로 삼는다.
.env
.env.*
!.env.example

# 로컬 node_modules를 올릴 이유가 없다 — Vercel이 빌드 때 직접 설치한다.
node_modules/
