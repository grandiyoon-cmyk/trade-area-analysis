# 이 파일은 "형식 견본"입니다. 실제 값은 같은 폴더의 .env 에 넣으세요.
# (.env 는 .gitignore로 막혀 있고, 이 .env.example 만 저장소에 올라갑니다 — 저장소가 Public이라
#  실제 키가 여기 들어가면 그대로 전 세계에 공개됩니다. 절대 채워 넣지 마세요.)

# ─────────────────────────────────────────────────────────────────────────────
# 1. 소상공인시장진흥공단 상가(상권)정보 API  [필수]
# ─────────────────────────────────────────────────────────────────────────────
# https://www.data.go.kr/data/15012005/openapi.do 에서 활용신청 후 발급받은
# "일반 인증키"를 넣습니다. 신청은 보통 즉시~수십 분 내 자동 승인됩니다.
# Encoding/Decoding 키 어느 쪽을 넣어도 코드가 알아서 처리합니다.
SEMAS_SERVICE_KEY=여기에_발급받은_서비스키를_붙여넣으세요

# 로컬 서버가 열릴 포트
PORT=8788


# ─────────────────────────────────────────────────────────────────────────────
# 2. 네이버 지도  [선택 — 없으면 좌표 산점도로 대체됩니다]
# ─────────────────────────────────────────────────────────────────────────────
# Naver Cloud Platform 콘솔 > Services > Application Services > Maps > Application
# 에서 앱을 등록하면 Client ID 와 Client Secret 이 한 쌍으로 나옵니다.
# 이 둘은 성격이 완전히 다르니 헷갈리지 마세요.

# ── Client ID : 공개값입니다 ──
# 브라우저의 <script src="...maps.js?ncpKeyId=여기"> 에 그대로 들어가므로, 누구나
# 개발자도구로 볼 수 있습니다. 시크릿이 아닙니다. 도용을 막는 수단은 이 값을 숨기는 게
# 아니라 **콘솔의 "Web 서비스 URL" 등록**입니다 — 등록되지 않은 주소에서 호출하면 거부됩니다.
#
# 반드시 아래 주소를 전부 등록하세요(하나라도 빠지면 그 주소에서 인증 실패):
#   https://trade-area-analysis-theta.vercel.app
#   https://trade-area-analysis-grandiyoon-cmyks-projects.vercel.app
#   http://localhost:8788
#
# 그리고 Application 설정에서 "Web Dynamic Map"이 켜져 있어야 합니다(안 켜면 429 Quota 오류).
NAVER_MAPS_CLIENT_ID=

# ── Client Secret : 진짜 시크릿입니다 ──
# 절대 브라우저로 내보내면 안 됩니다. 서버(backend)에서만 씁니다.
# 지도를 화면에 띄우는 데는 필요 없고, 아래 같은 **서버 호출용 API**를 쓸 때 필요합니다:
#   - Geocoding      : 주소 → 좌표  (예: "강남대로 396" 을 입력해 반경분석)
#   - Reverse Geocode: 좌표 → 주소
#   - Directions     : 경로/거리 계산
# 지금 이 앱은 아직 이 API들을 쓰지 않으므로 비워둬도 됩니다. 나중에 "주소로 검색해서
# 반경분석" 같은 기능을 붙일 때 여기에 넣으면 됩니다.
#
# ⚠️ 이 값은 /api/config 응답에 절대 포함되지 않습니다(서버가 Client ID만 내려줍니다).
#    새 기능을 만들 때도 이 값이 프런트로 새어나가지 않게 주의하세요.
NAVER_MAPS_CLIENT_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# 3. 데이터베이스  [Vercel 배포 시 자동 주입 — 로컬에선 보통 불필요]
# ─────────────────────────────────────────────────────────────────────────────
# Vercel Storage에 Neon(Postgres)을 연결하면 DATABASE_URL이 자동으로 들어갑니다.
# 로컬에서도 즐겨찾기를 쓰고 싶을 때만 직접 넣으세요. 없으면 캐시는 파일로 폴백하고
# 즐겨찾기는 503으로 "DB 연결 필요"를 안내합니다.
# DATABASE_URL=
